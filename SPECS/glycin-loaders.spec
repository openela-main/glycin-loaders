# Backport of the fix for a use-after-free with duplicate XML entities in the
# bundled librsvg 2.58.0. Adapted from librsvg upstream MR !1222
# (https://gitlab.gnome.org/GNOME/librsvg/-/merge_requests/1222), fixing
# https://gitlab.gnome.org/GNOME/librsvg/-/work_items/1241
Patch0:         glycin-loaders-librsvg-fix-uaf-duplicate-xml-entities.patch

# https://fedoraproject.org/wiki/Changes/EncourageI686LeafRemoval
ExcludeArch:    %{ix86}

%if 0%{?rhel}
BuildRequires:  rust-toolset
%else
BuildRequires:  cargo-rpm-macros
%endif
BuildRequires:  git-core
BuildRequires:  meson
BuildRequires:  pkgconfig(gtk4)
BuildRequires:  pkgconfig(libseccomp)
%if %{with heif}
BuildRequires:  pkgconfig(libheif)
%endif
%if %{with jpegxl}
BuildRequires:  pkgconfig(libjxl)
%endif
BuildRequires:  pkgconfig(cairo)

%description
Sandboxed and extendable image decoding.


%prep
%autosetup -p1 -n glycin-loaders-%{tarball_version}

%if 0%{?bundled_rust_deps}
# We patch vendored crate sources (see Patch* above). cargo verifies each
# vendored crate against the per-file hashes in its .cargo-checksum.json, which
# would reject any patched file. The source tarball is trusted, so empty the
# "files" map of every vendored crate to disable per-file verification; this
# means future source backports need no checksum bookkeeping. The "package"
# field (matched against Cargo.lock) is left untouched.
find vendor -name .cargo-checksum.json -print0 \
  | xargs -0 sed -i -E 's/"files":\{[^}]*\}/"files":{}/'
%cargo_prep -v vendor
%else
rm -rf vendor
%cargo_prep
%endif


%if ! 0%{?bundled_rust_deps}
%generate_buildrequires
%cargo_generate_buildrequires
%endif


%build
%meson \
  -Dloaders=%{?with_heif:glycin-heif,}glycin-image-rs,%{?with_jpegxl:glycin-jxl,}glycin-svg \
  -Dtest_skip_install=true \
  %{nil}

%meson_build

%cargo_license_summary
%{cargo_license} > LICENSE.dependencies
%if 0%{?bundled_rust_deps}
%cargo_vendor_manifest
%endif


%install
%meson_install


%if %{with check}
%check
# Something is wrong with the test setup and tests fail with
# "No such file or directory"
%meson_test || :
%endif


%files
%license LICENSE LICENSE-LGPL-2.1 LICENSE-MPL-2.0
%license LICENSE.dependencies
%if 0%{?bundled_rust_deps}
%license cargo-vendor.txt
%endif
%doc NEWS README.md
%{_libexecdir}/glycin-loaders/
%{_datadir}/glycin-loaders/


